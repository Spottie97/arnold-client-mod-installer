#!/usr/bin/env bash
# Build and sign manifest.json + SHA512SUMS.txt for GitHub release tag mods-2026.11.4.
# Usage:
#   tools/release-manifest --test-key
#   tools/release-manifest --from-folder /path/to/release-mods-2026.11.1
#   MANIFEST_SIGNING_KEY=... tools/release-manifest --out dist/mods --assets tools/release-data
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
exec cargo run --quiet --manifest-path "$root/src-tauri/Cargo.toml" --bin release-manifest -- \
  --in "$root/fixtures/manifest.v3.json" \
  --assets "$root/tools/release-data" \
  --tag mods-2026.11.4 \
  "$@"
